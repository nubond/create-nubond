{
  "name": "{APP_NAME_IN_LOWER_CASE}",
  "source": "./src/index.html",
  "nubond": {
    "languageService": true
  },
  "alias": {},
  "staticFiles": [
    {
      "staticPath": "./assets/favicon.ico"
    }
  ],
  "scripts": {
    "prestart": "node package-cli.js --root-cwd remove-directory dist",
    "start": "parcel",
    "prebuild": "node package-cli.js --root-cwd remove-directory dist",
    "build": "parcel build --no-source-maps",
    "add-component": "node package-cli.js --init-cwd add-component scss",
    "acomp": "node package-cli.js --init-cwd add-component scss",
    "add-container": "node package-cli.js --init-cwd add-container",
    "acont": "node package-cli.js --init-cwd add-container",
    "add-aspect": "node package-cli.js --init-cwd add-aspect",
    "aasp": "node package-cli.js --init-cwd add-aspect",
    "add-transformer": "node package-cli.js --init-cwd add-transformer",
    "atran": "node package-cli.js --init-cwd add-transformer",
    "add-injectable": "node package-cli.js --init-cwd add-injectable",
    "ainj": "node package-cli.js --init-cwd add-injectable"
  },
  "devDependencies": {
    "@nubond/posthtml-value-interpolation": "^1.0.3",
    "@parcel/transformer-inline-string": "^2.16.1",
    "@parcel/transformer-sass": "^2.16.1",
    "@parcel/transformer-typescript-tsc": "^2.16.1",
    "@types/node": "^25.5.2",
    "parcel": "^2.16.1",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "posthtml": "^0.16.7"
  },
  "dependencies": {
    "nubond": "^1.0.9"
  }
}
